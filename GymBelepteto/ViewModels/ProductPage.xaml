<Page x:Class="GymBelepteto.ViewModels.ProductPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:GymBelepteto.ViewModels"
      mc:Ignorable="d"
      Title="ProductPage"
      Background="#121214">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="280"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Termékek és Készlet" FontSize="22" Foreground="White" FontWeight="Bold" Margin="0,0,0,20"/>

            <DataGrid x:Name="ProductsDataGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" RowHeight="35"
                      Background="#1A1A1E" RowBackground="#1A1A1E" AlternatingRowBackground="#222226" 
                      Foreground="White" BorderThickness="0" GridLinesVisibility="None" SelectionMode="Single">

                <DataGrid.Resources>
                    <Style TargetType="DataGridRow">
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#CCFF00"/>
                                <Setter Property="Foreground" Value="#121214"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#25252A"/>
                        <Setter Property="Foreground" Value="#CCFF00"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="Padding" Value="10,5"/>
                    </Style>
                </DataGrid.Resources>

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Név" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Kategória" Binding="{Binding Category}" Width="100"/>
                    <DataGridTextColumn Header="Ár (Ft)" Binding="{Binding Price, StringFormat={}{0:N0}}" Width="80"/>
                    <DataGridTextColumn Header="Készlet" Binding="{Binding StockQuantity}" Width="80"/>
                    <DataGridCheckBoxColumn Header="Elérhető" Binding="{Binding IsAvailable}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Border Grid.Column="1" Background="#1A1A1E" CornerRadius="6" Padding="15">
            <StackPanel>
                <TextBlock Text="Termék Kezelése" Foreground="#CCFF00" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                <TextBlock Text="Termék neve" Foreground="White" Margin="0,5,0,2"/>
                <TextBox x:Name="TxtProductName" Height="30" Background="#121214" Foreground="White" BorderBrush="#333333" Padding="5,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Kategória" Foreground="White" Margin="0,10,0,2"/>
                <ComboBox x:Name="CmbCategory" Height="30" Background="#121214" Foreground="Black" SelectedIndex="0">
                    <ComboBoxItem Content="Bérlet"/>
                    <ComboBoxItem Content="Ital"/>
                    <ComboBoxItem Content="Kiegészítő"/>
                </ComboBox>

                <TextBlock Text="Ár (Ft)" Foreground="White" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtPrice" Height="30" Background="#121214" Foreground="White" BorderBrush="#333333" Padding="5,0" VerticalContentAlignment="Center"/>

                <TextBlock Text="Készlet" Foreground="White" Margin="0,10,0,2"/>
                <TextBox x:Name="TxtStock" Height="30" Background="#121214" Foreground="White" BorderBrush="#333333" Padding="5,0" VerticalContentAlignment="Center" Text="100"/>

                <CheckBox x:Name="ChkIsAvailable" Content="Aktív / Elérhető" Foreground="White" Margin="0,15,0,15" IsChecked="True"/>

                <Button Content="TERMÉK HOZZÁADÁSA" Height="35" Background="#CCFF00" Foreground="#121214" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="AddProductButton_Click" Margin="0,0,0,10"/>
                <Button Content="KÉSZLET NÖVELÉSE (+1)" Height="30" Background="#00ADB5" Foreground="White" FontWeight="Bold" BorderThickness="0" Cursor="Hand" Click="IncreaseStockButton_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>