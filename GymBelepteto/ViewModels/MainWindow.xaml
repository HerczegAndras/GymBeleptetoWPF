<Window x:Class="GymBelepteto.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GymBelepteto"
        mc:Ignorable="d"
        Title="Gym Manager ERP v1.0" Height="650" Width="1050" WindowStartupLocation="CenterScreen">
   
    <Grid Background="#121214">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Background="#1A1A1E">
            <StackPanel Margin="15,40,15,15">
                <TextBlock Text="GYM SYSTEM" Foreground="#CCFF00" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,40"/>

                <Button Content="Vendégek / Bérletek" Click="NavCustomers_Click" Margin="0,5" Padding="10" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontWeight="SemiBold"/>
                <Button Content="Termékek / Recepció" Margin="0,5" Padding="10" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontWeight="SemiBold"/>
                <Button Content="Felhasználók (Recepciósok)" Margin="0,5" Padding="10" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" FontWeight="SemiBold"/>
            </StackPanel>
        </Grid>

        <Frame Name="MainFrame" Grid.Column="1"  Margin="25"/>
    </Grid>
</Window>

    